# Cabeçalhos do Cloudflare Pages (equivalente ao [[headers]] do netlify.toml)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# O painel FTR busca os dados no servidor ao abrir: o HTML nunca pode ficar em cache velho.
/ftr/
  Cache-Control: no-cache
/ftr/index.html
  Cache-Control: no-cache
